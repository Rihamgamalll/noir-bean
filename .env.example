# Local MySQL connection. URL-encode special characters in the password.
DATABASE_URL="mysql://root:YOUR_MYSQL_PASSWORD@127.0.0.1:3306/noir_bean"

# Generate a unique value of at least 32 characters before production.
AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-characters"

# Owner code: enter this in the optional Admin access code field during registration.
ADMIN_PASSWORD="replace-with-a-strong-owner-code"

# Local development URL. Replace with your real HTTPS domain after deployment.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
